{
  "enabledMcpjsonServers": [
    "project-dev"
  ],
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  },
  "permissions": {
    "allow": [
      "mcp__project-dev__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/plugins/dev-tools/run_hook.sh pre_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/plugins/dev-tools/run_hook.sh post_tool",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agents/plugins/dev-tools/run_hook.sh stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
