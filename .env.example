# OpenWeightGym API connection (used by the Tool-First Dev knowledge-graph indexer)
# Existing API_IP / API_PORT / API_KEY variables are also recognized automatically.
OWG_PROTOCOL=http
OWG_HOST=127.0.0.1
OWG_PORT=8442
OWG_API_KEY=your-api-key-here

# Optional: leave blank to auto-pick from GET /v1/models
OWG_EMBEDDING_MODEL=
OWG_SUMMARY_MODEL=
